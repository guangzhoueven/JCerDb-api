{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jcer-json",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jcer-json",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ]
}
